# Copy to .env and export these values before starting the backend.
DB_URL=jdbc:mysql://localhost:3306/billing?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace_with_your_mysql_password
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=false
MAX_CONCURRENT_SESSIONS=1
APP_BOOTSTRAP_ADMIN_USERNAME=your_admin_username
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password
